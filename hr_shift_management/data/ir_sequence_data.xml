<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_hr_shift_change_request" model="ir.sequence">
        <field name="name">Shift Change Request</field>
        <field name="code">hr.shift.change.request</field>
        <field name="prefix">SCR/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="ir_cron_expire_shift_assignments" model="ir.cron">
        <field name="name">Shift Management: Expire Assignments</field>
        <field name="model_id" ref="model_hr_shift_assignment"/>
        <field name="state">code</field>
        <field name="code">model._cron_expire_assignments()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
