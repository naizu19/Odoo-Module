<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Submitted → Approver -->
        <record id="mail_template_shift_submit" model="mail.template">
            <field name="name">Shift Management: Approval Required</field>
            <field name="model_id" ref="advance_hr_shift_management.model_hr_shift_change_request"/>
            <field name="subject">Shift Change Approval Required — {{ object.name }}</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="partner_to">{{ object.approver_id.partner_id.id }}</field>
            <field name="description">Sent to the approver when a shift change request is submitted.</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-size: 14px; color: #374151;">
    <p>Hello <strong><t t-out="object.approver_id.name or ''">Approver</t></strong>,</p>
    <p>
        <strong><t t-out="object.requested_by.name or ''">Manager</t></strong>
        has submitted a <strong>shift change request</strong> that requires your approval.
    </p>
    <table style="width: 100%; border-collapse: collapse; margin: 16px 0; font-size: 13px;">
        <tr>
            <td style="padding: 8px 12px; background: #f3f4f6; font-weight: 600; width: 140px;">Reference</td>
            <td style="padding: 8px 12px; border-bottom: 1px solid #e5e7eb;"><t t-out="object.name or ''">SCR/00001</t></td>
        </tr>
        <tr>
            <td style="padding: 8px 12px; background: #f3f4f6; font-weight: 600;">Employee</td>
            <td style="padding: 8px 12px; border-bottom: 1px solid #e5e7eb;"><t t-out="object.employee_id.name or ''">Employee</t></td>
        </tr>
        <tr>
            <td style="padding: 8px 12px; background: #f3f4f6; font-weight: 600;">Current Shift</td>
            <td style="padding: 8px 12px; border-bottom: 1px solid #e5e7eb;"><t t-out="object.current_shift_id.name or '—'">Morning</t></td>
        </tr>
        <tr>
            <td style="padding: 8px 12px; background: #f3f4f6; font-weight: 600;">Requested Shift</td>
            <td style="padding: 8px 12px; border-bottom: 1px solid #e5e7eb;">
                <strong><t t-out="object.requested_shift_id.name or ''">Night</t></strong>
                (<t t-out="object.requested_shift_id.display_time or ''">18:00 – 02:00</t>)
            </td>
        </tr>
        <tr>
            <td style="padding: 8px 12px; background: #f3f4f6; font-weight: 600;">Effective Period</td>
            <td style="padding: 8px 12px; border-bottom: 1px solid #e5e7eb;">
                <t t-out="object.date_from or ''">2026-06-01</t> → <t t-out="object.date_to or ''">2026-06-07</t>
            </td>
        </tr>
        <tr t-if="object.notes">
            <td style="padding: 8px 12px; background: #f3f4f6; font-weight: 600;">Reason</td>
            <td style="padding: 8px 12px;"><t t-out="object.notes or ''">—</t></td>
        </tr>
    </table>
    <p>Please review and approve or reject this request in Shift Management.</p>
    <p style="color: #6b7280; font-size: 12px; margin-top: 24px;">
        <t t-out="object.company_id.name or ''">Company</t> — Shift Management
    </p>
</div>
            </field>
            <field name="auto_delete" eval="True"/>
            <field name="lang">{{ object.approver_id.lang }}</field>
        </record>

        <!-- Approved → Employee + Requester -->
        <record id="mail_template_shift_approved" model="mail.template">
            <field name="name">Shift Management: Request Approved</field>
            <field name="model_id" ref="advance_hr_shift_management.model_hr_shift_change_request"/>
            <field name="subject">Shift Change Approved — {{ object.employee_id.name }}</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="description">Sent when a shift change request is approved.</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-size: 14px; color: #374151;">
    <p style="color: #059669; font-weight: 700; font-size: 16px;">✓ Shift Change Approved</p>
    <p>Hello,</p>
    <p>
        The shift change request <strong><t t-out="object.name or ''">SCR/00001</t></strong>
        for <strong><t t-out="object.employee_id.name or ''">Employee</t></strong> has been
        <strong style="color: #059669;">approved</strong>.
    </p>
    <table style="width: 100%; border-collapse: collapse; margin: 16px 0; font-size: 13px;">
        <tr>
            <td style="padding: 8px 12px; background: #ecfdf5; font-weight: 600; width: 140px;">New Shift</td>
            <td style="padding: 8px 12px; border-bottom: 1px solid #d1fae5;">
                <strong><t t-out="object.requested_shift_id.name or ''">Night</t></strong>
                (<t t-out="object.requested_shift_id.display_time or ''">18:00 – 02:00</t>)
            </td>
        </tr>
        <tr>
            <td style="padding: 8px 12px; background: #ecfdf5; font-weight: 600;">Effective Period</td>
            <td style="padding: 8px 12px;">
                <t t-out="object.date_from or ''">2026-06-01</t> → <t t-out="object.date_to or ''">2026-06-07</t>
            </td>
        </tr>
    </table>
    <p>The new shift assignment is now active. Please follow your updated schedule.</p>
    <p style="color: #6b7280; font-size: 12px; margin-top: 24px;">
        Approved by <t t-out="user.name or ''">Approver</t> —
        <t t-out="object.company_id.name or ''">Company</t>
    </p>
</div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <!-- Rejected → Requester + Employee -->
        <record id="mail_template_shift_rejected" model="mail.template">
            <field name="name">Shift Management: Request Rejected</field>
            <field name="model_id" ref="advance_hr_shift_management.model_hr_shift_change_request"/>
            <field name="subject">Shift Change Rejected — {{ object.employee_id.name }}</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="description">Sent when a shift change request is rejected.</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-size: 14px; color: #374151;">
    <p style="color: #dc2626; font-weight: 700; font-size: 16px;">✗ Shift Change Rejected</p>
    <p>Hello,</p>
    <p>
        The shift change request <strong><t t-out="object.name or ''">SCR/00001</t></strong>
        for <strong><t t-out="object.employee_id.name or ''">Employee</t></strong> has been
        <strong style="color: #dc2626;">rejected</strong>.
    </p>
    <table style="width: 100%; border-collapse: collapse; margin: 16px 0; font-size: 13px;">
        <tr>
            <td style="padding: 8px 12px; background: #fef2f2; font-weight: 600; width: 140px;">Requested Shift</td>
            <td style="padding: 8px 12px; border-bottom: 1px solid #fecaca;">
                <t t-out="object.requested_shift_id.name or ''">Night</t>
            </td>
        </tr>
        <tr t-if="object.rejection_reason">
            <td style="padding: 8px 12px; background: #fef2f2; font-weight: 600;">Reason</td>
            <td style="padding: 8px 12px;"><t t-out="object.rejection_reason or ''">—</t></td>
        </tr>
    </table>
    <p>No changes were made to the employee's shift schedule.</p>
    <p style="color: #6b7280; font-size: 12px; margin-top: 24px;">
        Rejected by <t t-out="user.name or ''">Approver</t> —
        <t t-out="object.company_id.name or ''">Company</t>
    </p>
</div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <!-- Cancelled → Approver + Requester -->
        <record id="mail_template_shift_cancelled" model="mail.template">
            <field name="name">Shift Management: Request Cancelled</field>
            <field name="model_id" ref="advance_hr_shift_management.model_hr_shift_change_request"/>
            <field name="subject">Shift Change Cancelled — {{ object.name }}</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="description">Sent when a submitted shift change request is cancelled.</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-size: 14px; color: #374151;">
    <p style="color: #d97706; font-weight: 700; font-size: 16px;">Shift Change Request Cancelled</p>
    <p>Hello,</p>
    <p>
        The shift change request <strong><t t-out="object.name or ''">SCR/00001</t></strong>
        for <strong><t t-out="object.employee_id.name or ''">Employee</t></strong> has been
        <strong>cancelled</strong> and no longer requires action.
    </p>
    <table style="width: 100%; border-collapse: collapse; margin: 16px 0; font-size: 13px;">
        <tr>
            <td style="padding: 8px 12px; background: #fffbeb; font-weight: 600; width: 140px;">Employee</td>
            <td style="padding: 8px 12px; border-bottom: 1px solid #fde68a;"><t t-out="object.employee_id.name or ''">Employee</t></td>
        </tr>
        <tr>
            <td style="padding: 8px 12px; background: #fffbeb; font-weight: 600;">Requested Shift</td>
            <td style="padding: 8px 12px;"><t t-out="object.requested_shift_id.name or ''">Night</t></td>
        </tr>
    </table>
    <p style="color: #6b7280; font-size: 12px; margin-top: 24px;">
        <t t-out="object.company_id.name or ''">Company</t> — Shift Management
    </p>
</div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

    </data>
</odoo>
