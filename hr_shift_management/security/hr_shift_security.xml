<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_shift_management" model="ir.module.category">
        <field name="name">Shift Management</field>
        <field name="description">Manage employee shifts and approvals</field>
        <field name="sequence">25</field>
    </record>

    <record id="group_shift_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_shift_management"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_shift_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_shift_management"/>
        <field name="implied_ids" eval="[(4, ref('group_shift_user'))]"/>
    </record>

    <record id="group_shift_approver" model="res.groups">
        <field name="name">Approver</field>
        <field name="category_id" ref="module_category_shift_management"/>
        <field name="implied_ids" eval="[(4, ref('group_shift_manager'))]"/>
    </record>

    <record id="group_shift_officer" model="res.groups">
        <field name="name">Officer</field>
        <field name="category_id" ref="module_category_shift_management"/>
        <field name="implied_ids" eval="[(4, ref('group_shift_approver')), (4, ref('hr.group_hr_user'))]"/>
    </record>

    <record id="shift_assignment_rule_manager" model="ir.rule">
        <field name="name">Shift Assignment: manager sees team</field>
        <field name="model_id" ref="model_hr_shift_assignment"/>
        <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('employee_id.parent_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_shift_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="shift_assignment_rule_officer" model="ir.rule">
        <field name="name">Shift Assignment: officer sees all</field>
        <field name="model_id" ref="model_hr_shift_assignment"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_shift_officer'))]"/>
    </record>

    <record id="shift_change_request_rule_manager" model="ir.rule">
        <field name="name">Shift Change Request: manager sees own team</field>
        <field name="model_id" ref="model_hr_shift_change_request"/>
        <field name="domain_force">['|', '|', ('employee_id.user_id', '=', user.id), ('requested_by', '=', user.id), ('employee_id.parent_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_shift_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="shift_change_request_rule_approver" model="ir.rule">
        <field name="name">Shift Change Request: approver sees assigned</field>
        <field name="model_id" ref="model_hr_shift_change_request"/>
        <field name="domain_force">['|', ('approver_id', '=', user.id), ('requested_by', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_shift_approver'))]"/>
    </record>

    <record id="shift_change_request_rule_officer" model="ir.rule">
        <field name="name">Shift Change Request: officer sees all</field>
        <field name="model_id" ref="model_hr_shift_change_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_shift_officer'))]"/>
    </record>

    <record id="shift_template_multi_company_rule" model="ir.rule">
        <field name="name">Shift Template: multi-company</field>
        <field name="model_id" ref="model_hr_shift_template"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
