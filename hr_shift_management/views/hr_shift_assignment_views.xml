<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_shift_assignment_view_tree" model="ir.ui.view">
        <field name="name">hr.shift.assignment.tree</field>
        <field name="model">hr.shift.assignment</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'expired'">
                <field name="employee_id"/>
                <field name="shift_id"/>
                <field name="shift_display_time"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-info="state == 'draft'"
                       decoration-muted="state == 'expired'"/>
                <field name="company_id" groups="base.group_multi_company" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="hr_shift_assignment_view_form" model="ir.ui.view">
        <field name="name">hr.shift.assignment.form</field>
        <field name="model">hr.shift.assignment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" string="Activate" type="object"
                            class="btn-primary" invisible="state != 'draft'"
                            groups="hr_shift_management.group_shift_officer"/>
                    <button name="action_expire" string="Expire" type="object"
                            invisible="state != 'active'"
                            groups="hr_shift_management.group_shift_officer"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,expired"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="shift_id" readonly="state != 'draft'"/>
                            <field name="shift_display_time"/>
                        </group>
                        <group>
                            <field name="date_from" readonly="state != 'draft'"/>
                            <field name="date_to" readonly="state != 'draft'"/>
                            <field name="change_request_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hr_shift_assignment_view_calendar" model="ir.ui.view">
        <field name="name">hr.shift.assignment.calendar</field>
        <field name="model">hr.shift.assignment</field>
        <field name="arch" type="xml">
            <calendar string="Shift Assignments" date_start="date_from" date_stop="date_to"
                      color="shift_id" mode="month">
                <field name="employee_id"/>
                <field name="shift_id"/>
            </calendar>
        </field>
    </record>

    <record id="hr_shift_assignment_action" model="ir.actions.act_window">
        <field name="name">Shift Assignments</field>
        <field name="res_model">hr.shift.assignment</field>
        <field name="view_mode">list,calendar,form</field>
    </record>
</odoo>
