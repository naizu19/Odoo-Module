<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_shift" model="ir.ui.view">
        <field name="name">res.config.settings.form.shift</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='hr']" position="inside">
                <block title="Shift Management" name="shift_management_settings">
                    <setting string="Default Shift Approver"
                             help="Default user notified to approve shift change requests.">
                        <field name="shift_default_approver_id"/>
                    </setting>
                    <setting string="Grace Period"
                             help="Minutes of tolerance before marking attendance as late.">
                        <field name="shift_grace_period_minutes"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
