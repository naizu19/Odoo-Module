<odoo>
    <record id="view_individual_employee_report_wizard_form" model="ir.ui.view">
        <field name="name">individual.employee.attendance.report.wizard.form</field>
        <field name="model">individual.attendance.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Individual attendance report">
                <group>
                    <group>
                        <field name="employee_id"/>
                    </group>
                    <group>
                        <field name="report_header"/>
                        <field name="month"/>
                        <field name="year"/>
                    </group>
                </group>
                <footer>
                    <button name="export_individual_employee_report" string="Print Report"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="new_action_individual_employee_report_wizard" model="ir.actions.act_window">
        <field name="name">Individual Employee Attendance</field>
        <field name="res_model">individual.attendance.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_individual_employee_report_wizard_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="new_individual_employee_report_menu"
              name="Individual Employee Attendance"
              parent="st_biomatric_attendance_xlsx_report.menu_st_hik_attendance_reporting"
              action="st_biomatric_attendance_xlsx_report.new_action_individual_employee_report_wizard"
              sequence="20"/>
</odoo>
