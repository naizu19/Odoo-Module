<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_shift_template_view_tree" model="ir.ui.view">
        <field name="name">hr.shift.template.tree</field>
        <field name="model">hr.shift.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="display_time"/>
                <field name="duration_hours" widget="float_time"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="hr_shift_template_view_form" model="ir.ui.view">
        <field name="name">hr.shift.template.form</field>
        <field name="model">hr.shift.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="color" widget="color_picker"/>
                            <field name="work_entry_type_id"/>
                        </group>
                        <group>
                            <field name="start_hour" widget="float_time"/>
                            <field name="end_hour" widget="float_time"/>
                            <field name="crosses_midnight"/>
                            <field name="break_duration"/>
                            <field name="duration_hours" widget="float_time"/>
                            <field name="display_time"/>
                        </group>
                    </group>
                    <group string="Working Days">
                        <group>
                            <field name="work_monday"/>
                            <field name="work_tuesday"/>
                            <field name="work_wednesday"/>
                            <field name="work_thursday"/>
                        </group>
                        <group>
                            <field name="work_friday"/>
                            <field name="work_saturday"/>
                            <field name="work_sunday"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_shift_template_action" model="ir.actions.act_window">
        <field name="name">Shifts</field>
        <field name="res_model">hr.shift.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
