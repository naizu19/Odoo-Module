<odoo>
    <record id="view_department_attendance_report_wizard_form" model="ir.ui.view">
        <field name="name">department.attendance.report.wizard.form</field>
        <field name="model">department.attendance.report.wizard</field>
        <field name="arch" type="xml">
            <form string="All employees/Dept attendance report">
                <group>
                    <group>
                        <field name="department_id" placeholder="Leave empty for all employees"/>
                        <field name="include_child_departments" invisible="not department_id"/>
                    </group>
                    <group>
                        <field name="report_header"/>
                        <field name="month"/>
                        <field name="year"/>
                    </group>
                </group>
                <footer>
                    <button name="export_department_attendance_xlsx" string="Print Report" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_department_attendance_report_wizard" model="ir.actions.act_window">
        <field name="name">All employees/Dept attendance report</field>
        <field name="res_model">department.attendance.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_department_attendance_report_wizard_form"/>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_department_attendance_report_wizard"
        name="All employees/Dept attendance report"
        parent="st_biomatric_attendance_xlsx_report.menu_st_hik_attendance_reporting"
        action="st_biomatric_attendance_xlsx_report.action_department_attendance_report_wizard"
        sequence="10"/>
</odoo>

