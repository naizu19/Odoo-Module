<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_shift_change_request_view_tree" model="ir.ui.view">
        <field name="name">hr.shift.change.request.tree</field>
        <field name="model">hr.shift.change.request</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('rejected', 'cancelled')">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="current_shift_id"/>
                <field name="requested_shift_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="requested_by"/>
                <field name="approver_id"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'submitted'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="hr_shift_change_request_view_form" model="ir.ui.view">
        <field name="name">hr.shift.change.request.form</field>
        <field name="model">hr.shift.change.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" string="Submit" type="object" class="btn-primary"
                            invisible="state != 'draft'"
                            groups="hr_shift_management.group_shift_manager"/>
                    <button name="action_approve" string="Approve" type="object" class="btn-primary"
                            invisible="not can_approve"/>
                    <button name="action_reject" string="Reject" type="object"
                            invisible="not can_approve"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state not in ('draft', 'submitted')"
                            groups="hr_shift_management.group_shift_manager"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                            invisible="state not in ('rejected', 'cancelled')"
                            groups="hr_shift_management.group_shift_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="current_shift_id"/>
                            <field name="requested_shift_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="date_from" readonly="state != 'draft'"/>
                            <field name="date_to" readonly="state != 'draft'"/>
                            <field name="requested_by"/>
                            <field name="approver_id" readonly="state != 'draft'"/>
                            <field name="can_approve" invisible="1"/>
                            <field name="assignment_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" readonly="state != 'draft'"/>
                        <field name="rejection_reason" invisible="state != 'rejected'"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hr_shift_change_request_view_kanban" model="ir.ui.view">
        <field name="name">hr.shift.change.request.kanban</field>
        <field name="model">hr.shift.change.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="requested_shift_id"/>
                <field name="state"/>
                <field name="can_approve"/>
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold"/>
                        <div><field name="employee_id"/></div>
                        <div><field name="requested_shift_id"/></div>
                        <div class="text-muted">
                            <field name="date_from"/> → <field name="date_to"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="hr_shift_change_request_action" model="ir.actions.act_window">
        <field name="name">Shift Change Requests</field>
        <field name="res_model">hr.shift.change.request</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_submitted': 0}</field>
    </record>

    <record id="hr_shift_change_request_view_search" model="ir.ui.view">
        <field name="name">hr.shift.change.request.search</field>
        <field name="model">hr.shift.change.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="requested_shift_id"/>
                <field name="approver_id"/>
                <filter name="submitted" string="Pending Approval"
                        domain="[('state', '=', 'submitted')]"/>
                <filter name="approved" string="Approved"
                        domain="[('state', '=', 'approved')]"/>
                <filter name="my_approvals" string="My Approvals"
                        domain="[('approver_id', '=', uid)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
