<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="shift_work_entry_regenerate_view_form" model="ir.ui.view">
        <field name="name">shift.work.entry.regenerate.wizard.form</field>
        <field name="model">shift.work.entry.regenerate.wizard</field>
        <field name="arch" type="xml">
            <form string="Regenerate Shift Work Entries">
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="employee_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button name="action_regenerate" string="Regenerate" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
