<odoo>
    <record id="view_payslip_payment_wizard_form" model="ir.ui.view">
        <field name="name">payslip.payment.wizard.form</field>
        <field name="model">payslip.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Selective Payslip Payment">
                <group>
                    <field name="journal_id"/>
                    <field name="payment_date"/>
                </group>
                <notebook>
                    <page string="Payment Lines">
                        <field name="line_ids" nolabel="1">
                            <tree editable="bottom">
                                <field name="select"/>
                                <field name="payslip_id"/>
                                <field name="employee_id" readonly="1"/>
                                <field name="due_amount" readonly="1"/>
                                <field name="already_paid" readonly="1"/>
                                <field name="remaining" readonly="1"/>
                                <field name="payment_amount"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button name="action_confirm_payment"
                            type="object"
                            string="Confirm Payment"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
