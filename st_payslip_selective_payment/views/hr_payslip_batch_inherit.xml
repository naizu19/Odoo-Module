<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_payslip_batch_form_inherit_payment" model="ir.ui.view">
        <field name="name">hr.payslip.run.form.payment.inherit</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="hr_payroll.hr_payslip_run_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="open_payment_wizard"
                        type="object"
                        string="Generate Payment (Selective)"
                        class="btn-primary"
                        invisible="state != 'close'"/>
            </xpath>
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="widget">statusbar</attribute>
                <attribute name="statusbar_visible">draft,verify,confirm, approve, close,partial,paid, refuse,close</attribute>
            </xpath>
        </field>
    </record>
    <record id="view_hr_payslip_form_inherit_partial_state" model="ir.ui.view">
        <field name="name">hr.payslip.form.inherit.partial.state</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <!-- Extend statusbar to include Partially Paid -->
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="statusbar_visible">draft,verify,confirm, approve, close,partial,paid, refuse,close</attribute>
            </xpath>
        </field>
    </record>
</odoo>
