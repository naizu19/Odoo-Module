<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hik_sync_log_list" model="ir.ui.view">
        <field name="name">hik.sync.log.list</field>
        <field name="model">hik.sync.log</field>
        <field name="arch" type="xml">
            <list decoration-danger="status == 'error'" decoration-success="status == 'success'">
                <field name="create_date"/>
                <field name="name"/>
                <field name="status"/>
                <field name="events_found"/>
                <field name="execution_time" widget="float" string="Time (ms)"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <record id="view_hik_sync_log_form" model="ir.ui.view">
        <field name="name">hik.sync.log.form</field>
        <field name="model">hik.sync.log</field>
        <field name="arch" type="xml">
            <form string="Sync Log">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date"/>
                            <field name="name"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="events_found"/>
                            <field name="attendance_created"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="General Info">
                            <group>
                                <field name="message" readonly="1"/>
                                <field name="error_details" readonly="1" invisible="status == 'success'"/>
                            </group>
                        </page>
                        <page string="Diagnostics">
                            <group>
                                <field name="execution_time" readonly="1"/>
                                <field name="request_payload" readonly="1"/>
                                <field name="response_data" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hik_sync_log" model="ir.actions.act_window">
        <field name="name">Sync Logs</field>
        <field name="res_model">hik.sync.log</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Check the status of HikCentral attendance synchronization.
            </p>
        </field>
    </record>

    <menuitem id="menu_hik_sync_log" name="Sync Logs" parent="menu_hik_root" action="action_hik_sync_log" sequence="20"/>

</odoo>
